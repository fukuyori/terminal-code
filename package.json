{
  "name": "tode",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "tode": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/write-cjs-boundary.js && npm run -s build:pages",
    "build:pages": "node scripts/build-pages.mjs",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "dist": "bash scripts/dist.sh",
    "dist:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dist-windows.ps1",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-windows.ps1",
    "installer:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/installer-windows.ps1",
    "publish:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-windows.ps1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/pages/tsconfig.json",
    "test": "npm run -s build && node --test \"test/*.test.js\"",
    "start": "npm run -s build && node dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@zenbu-labs/pixel": "0.0.23",
    "react": "^18.3.1"
  },
  "allowScripts": {
    "@zenbu-labs/pixel@0.0.23": true
  }
}
